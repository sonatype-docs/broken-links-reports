# Broken Link Checker Configuration

# Documentation URLs to check (comma-separated)
DOCS_URLS=https://help.sonatype.com/en/sonatype-product-overview.html

# Crawl Settings
MAX_CRAWL_DEPTH=4
MAX_PAGES_PER_SITE=0
MAX_LINKS_TO_CHECK=0
FOLLOW_EXTERNAL_LINKS=false
CHECK_EXTERNAL_LINKS=false
REQUEST_TIMEOUT_SECONDS=10
PARALLEL_WORKERS=50

# Exclude Patterns (regex, comma-separated)
# Skip URLs matching these patterns
EXCLUDE_PATTERNS=https://help.sonatype.com/cdn-cgi/l/email-protection,http://your-host:8095/crowd,https://sso.your.domain/auth/realms/nexus,https://help.sonatype.com/en/404-page.html,https://repo1.dso.mil/dsop/sonatype/nexus/nexus,https://repo1.dso.mil/dsop/sonatype/nexus-iq-server/nexus-iq-server,https://github.com/samplecount/samplerepo,https://repo.sonatype.com/repository/sonatype-hosted/pki/deb-gpg/GPG-KEY-sonatype-apt-hosted.asc,urn:resource:component:,https://support.sonatype.com/hc/en-us/articles/1500000415082,https://plugins.jenkins.io/nexus-jenkins-plugin/,https://support.sonatype.com/hc/en-us/articles/4408801690515,https://support.sonatype.com/hc/en-us/articles/4409326330003

# Notification Settings
ENABLE_DESKTOP_NOTIFICATIONS=true
ENABLE_SLACK_NOTIFICATIONS=false
NOTIFICATION_SOUND=Glass

# Slack Settings
SLACK_WEBHOOK_URL=
SLACK_CHANNEL=

# GitHub Pages Settings
ENABLE_GITHUB_UPLOAD=true
GITHUB_REPO_NAME=broken-links-reports
GITHUB_USERNAME=sonatype-docs

# Alert Thresholds
MIN_BROKEN_LINKS_FOR_ALERT=1
NOTIFY_ON_COMPLETION=true

# Scheduled Mode
CHECK_INTERVAL_HOURS=24
